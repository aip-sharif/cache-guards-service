# ---- Guard warmup (cache_api) -------------------------------------------
# After a cache with guard.enabled=true is registered/edited, the APP fires one
# chat/completions request at the gateway with that project's own cache_key so
# the guard index (policy exemplar embeddings) is built up-front instead of on
# the first real user request. Inside docker compose use http://api:8080/...
SC_GATEWAY_CHAT_URL=http://localhost:8080/v1/chat/completions
GUARD_WARMUP_ENABLED=true
GUARD_WARMUP_PROMPT=Can you talk about my project?
GUARD_WARMUP_TIMEOUT=120
