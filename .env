POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb
POSTGRES_PORT=1379
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@db:1379/mydb

CLIENT_ID=728a50bb7ebe2316ab96
CLIENT_SECRET=f1017666c3f8382b1069f3197b1558acb636028e
CASSDOOR_ENDPOINT=https://iampilot.aip.sharif.ir/
APPLICATION_NAME=application_panel
ORGANZATION_NAME=organization_sharif
CERT=app/cert.pem
EXTERNAL_API_URL=http://localhost:8080/gw/admin/projects  
#http://host.docker.internal:8080/gw/admin/projects
SC_GATEWAY_ADMIN_KEY=sc-change-me

# =========================================================================
# REQUIRED — /v1/* answers 503 naming the missing variable until all four
# of these are set.
# =========================================================================
SC_PG_DSN=postgresql://scuser:scpass@postgres:5432/sccache   # DB must exist; we create only the `gw` schema
SC_APP_CONFIG_URL=http://app-config:8000/cache/key           # THE BACKEND'S endpoint (Part B). One fixed URL.
SC_LLM_BASE_URL=https://rmgpilot.aip.sharif.ir               # chat endpoint; we POST {url}/v1/chat/completions
SC_EMBED_BASE_URL=https://rmgpilot.aip.sharif.ir/v1/embeddings             # embeddings endpoint for the cache

# =========================================================================
# OPTIONAL — everything below has a working default.
# =========================================================================
SC_APP_CONFIG_TTL=60              # seconds a client's config is cached in memory
SC_EXTRACTOR_BASE_URL=            # only used when the APP returns an extractor model
SC_GATEWAY_UPSTREAM_TIMEOUT=120   # upstream LLM timeout, seconds

# ---- Redis (the serving cache) ------------------------------------------
SC_REDIS_HOST=localhost
SC_REDIS_PORT=6379
SC_REDIS_PASSWORD=hi_redis
SC_REDIS_IS_CLUSTER=false
# SC_REDIS_SENTINELS=sentinel-a:26379,sentinel-b:26379
# SC_REDIS_SENTINEL_MASTER=mymaster

# ---- Cache defaults (per-client values from Part B override these) -------
SC_SIMILARITY_THRESHOLD=0.85
SC_DEFAULT_TTL=86400
SC_PERMANENT_HIT_THRESHOLD=5
SC_CACHE_INDEX_NAME=semantic_cache_idx
SC_EXACT_TIER=true

# ---- Input guard — ALL OPTIONAL -----------------------------------------
# NONE of these decides whether a client is guarded. That comes entirely from
# the APP's `guard` block (Part B). These are operator limits and fallbacks.
SC_GUARD_ENABLED=true             # break-glass: false = guard off for EVERY client
SC_GUARD_TIMEOUT=5.0              # whole-check deadline (embed + index + judge)
SC_GUARD_BUILD_TIMEOUT=60.0       # deadline for embedding one policy's exemplars
SC_GUARD_MAX_EXEMPLARS=5000       # policies above this are REFUSED, never truncated
SC_GUARD_MAX_POLICY_BYTES=262144  # 256 KiB cap on the inline policy YAML
SC_GUARD_CACHE_MAX_BYTES=268435456   # 256 MiB in-process budget for exemplar matrices
SC_GUARD_SEGMENT_MEMO_SIZE=50000
SC_GUARD_EMBED_BASE_URL=https://rmgpilot.aip.sharif.ir/v1/embeddings        # defaults to SC_EMBED_BASE_URL
SC_GUARD_JUDGE_BASE_URL=https://rmgpilot.aip.sharif.ir        # defaults to SC_LLM_BASE_URL

# ---- Admin / observability ----------------------------------------------
# SC_ADMIN_API_KEY=               # needed only for POST /admin/guard and legacy /v1/tenants
SC_LOG_LEVEL=INFO
SC_ENVIRONMENT=production
# SC_SENTRY_DSN=
SC_SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- docker compose only (host ports, read by compose, not the app) ------
APP_PORT=8080
REDIS_PORT=6379
PG_PORT=5432
