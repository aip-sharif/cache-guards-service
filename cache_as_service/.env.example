# =============================================================================
# Semantic Cache — environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and edit the values you care about. Every variable below is
# OPTIONAL — the defaults shown match the package defaults. Pydantic-settings
# auto-loads `.env` from the current working directory when present.
#
# All settings use the `SC_` prefix. Variable names are case-insensitive.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Redis backend
# -----------------------------------------------------------------------------
SC_REDIS_HOST=localhost
SC_REDIS_PORT=6379
# SC_REDIS_PASSWORD=changeme

# Cluster mode — set true for Redis Cluster topology.
SC_REDIS_IS_CLUSTER=false

# Sentinel mode — comma-separated host:port list + master name. Leave both
# unset for standalone connections.
# SC_REDIS_SENTINELS=sentinel-a:26379,sentinel-b:26379,sentinel-c:26379
# SC_REDIS_SENTINEL_MASTER=mymaster


# -----------------------------------------------------------------------------
# 2. Cache & similarity
# -----------------------------------------------------------------------------
# Cosine-similarity floor for a HIT in non-entity-aware mode. Higher = stricter.
SC_SIMILARITY_THRESHOLD=0.85

# Default Time-to-Live in seconds for new entries. 86400 = 24h.
SC_DEFAULT_TTL=86400

# How many hits an entry must accumulate to be promoted to permanent
# (TTL = -1). 0 disables auto-promotion.
SC_PERMANENT_HIT_THRESHOLD=5

# Base name of the RediSearch index. The active index is `<base>:v<N>` where
# N is the package schema version (currently 2). Old versions remain
# untouched so upgrades don't collide.
SC_CACHE_INDEX_NAME=semantic_cache_idx

# L0 exact-match tier: instant return + skip embedding on exact repeats.
# Recommended ON for the SaaS server.
SC_EXACT_TIER=true


# -----------------------------------------------------------------------------
# 2b. SaaS server (semantic_cache.server:create_app) — multi-tenant API
# -----------------------------------------------------------------------------
# Auth model:
#   * SSO JWT (preferred): clients send `Authorization: Bearer <jwt>`. The
#     tenant is the JWT's organization + user id claims; tenants auto-provision
#     on first login. No admin key needed for this path.
#   * Per-cache API keys (`sc-...`): minted by a tenant for machine-to-machine
#     access to ONE cache's data endpoints; rotatable.
#   * Legacy admin path: if SC_ADMIN_API_KEY is set, POST /v1/tenants (with the
#     admin bearer) creates a tenant + master key. Leave unset to disable it.
# SC_ADMIN_API_KEY=sc-change-me


# -----------------------------------------------------------------------------
# 2c. OpenAI-compatible gateway (optional)
# -----------------------------------------------------------------------------
# The gateway mounts when ALL FOUR of PG_DSN / APP_CONFIG_URL / LLM_BASE_URL /
# EMBED_BASE_URL are set. POST /v1/chat/completions checks the semantic cache
# first and proxies misses to the mlops LLM endpoint. The client's key IS the
# whole identity — the APP mints and validates it; this service never does.
#
# Embeddings are API-based — point the shared SaaS embedder at any
# OpenAI-compatible endpoint (OpenRouter, mlops, ...). No local model is
# baked into the Docker image. The gateway ignores these (its embed models
# come per-client from the APP); unset, they default to SC_EMBED_BASE_URL.
#SC_EMBEDDING_PROVIDER=custom_api
#SC_EMBEDDING_BASE_URL=https://openrouter.ai/api
#SC_EMBEDDING_API_KEY=sk-or-...
#SC_EMBEDDING_MODEL=openai/text-embedding-3-small

# Postgres stores: the served-message log and a durable backup of every cache
# entry (with its vector) — no keys, no configs. Redis stays the serving cache
# and is rebuilt from Postgres on boot after a wipe. The DB must already exist;
# only the `gw` schema is created inside it.
# SC_PG_DSN=postgresql://user:pass@your-postgres:5432/yourdb
#
# LOCAL DEV: compose bundles an ordinary Postgres, so `docker compose up -d`
# runs without an external DB. Use:
# SC_PG_DSN=postgresql://scuser:scpass@postgres:5432/sccache
# PG_PORT=5432

# The APP's config endpoint — a single fixed URL. We GET it forwarding the
# caller's own key as the bearer; the APP identifies the client from that key
# and returns its model / embed model / extractor model + their keys.
# SC_APP_CONFIG_URL=http://app-host:8000/cache

# Seconds a key's APP config is cached in memory before re-fetching.
SC_APP_CONFIG_TTL=60

# The mlops serving endpoints (models + keys come from the APP).
# SC_LLM_BASE_URL=https://mlops.example.com
# SC_EMBED_BASE_URL=https://mlops.example.com
# SC_EXTRACTOR_BASE_URL=https://mlops.example.com

# Timeout (seconds) for upstream LLM calls.
SC_GATEWAY_UPSTREAM_TIMEOUT=120

# --- Input guard (optional module, off unless the APP says otherwise) --------
# Whether a client is guarded, its policy, and its embedding + judge models all
# come from the APP's config response (`guard` block). NOTHING below is
# required and none of it gates the /v1 mount — these are operator limits and
# fallbacks only.
#
# Break-glass: false disables the guard for EVERY client without touching the
# APP. Also flippable at runtime with POST /admin/guard (needs SC_ADMIN_API_KEY).
SC_GUARD_ENABLED=true
# Whole-check deadline (embedding + index + judge). NOT the upstream timeout:
# the guard is inline and fail-closed, so a slow check is blocked live traffic.
SC_GUARD_TIMEOUT=5.0
# Deadline for embedding a policy's exemplars into an index. The build is
# server-owned, so a request that gives up waiting does not cancel it.
SC_GUARD_BUILD_TIMEOUT=60.0
# Rejection limits — the APP's config is refused, never silently truncated.
SC_GUARD_MAX_EXEMPLARS=5000
SC_GUARD_MAX_POLICY_BYTES=262144
# In-process byte budget for exemplar matrices (256 MiB) and the size of the
# per-segment decision memo.
SC_GUARD_CACHE_MAX_BYTES=268435456
SC_GUARD_SEGMENT_MEMO_SIZE=50000
# Serving endpoints for the guard's own embedding + judge calls. Unset, they
# fall back to SC_EMBED_BASE_URL / SC_LLM_BASE_URL above — which is why the
# guard adds no required variable.
# SC_GUARD_EMBED_BASE_URL=https://mlops.example.com
# SC_GUARD_JUDGE_BASE_URL=https://mlops.example.com


# -----------------------------------------------------------------------------
# 2d. Observability
# -----------------------------------------------------------------------------
# Root log level. The server logs ONE JSON object per line to stdout and
# nothing else (uvicorn access/error logs are routed through the same handler).
SC_LOG_LEVEL=INFO

# Environment tag surfaced to logs + Sentry.
SC_ENVIRONMENT=production

# Sentry error reporting (optional). Unset → disabled. Needs the extra:
#   pip install 'semantic-cache[sentry]'
# SC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SC_SENTRY_TRACES_SAMPLE_RATE=0.0


# -----------------------------------------------------------------------------
# 2e. docker compose only — variable substitution for docker-compose.yml
# -----------------------------------------------------------------------------
# These are read by `docker compose` itself (not the app) to pick host/container
# ports. Put them in a `.env` next to docker-compose.yml.
# REDIS_PORT=6379      # Redis bind + publish port (kept in sync with SC_REDIS_PORT)
# APP_PORT=8080        # Host port mapped to the API container's 8080


# -----------------------------------------------------------------------------
# 3. Normalization & translation (optional)
# -----------------------------------------------------------------------------
# When true, queries are translated into the target language before
# embedding. Requires `pip install 'semantic-cache[translate]'`. Falls back
# to a silent pass-through if the dep is missing.
SC_ENABLE_TRANSLATION=false
SC_TRANSLATION_TARGET_LANGUAGE=en


# -----------------------------------------------------------------------------
# 4. Embeddings
# -----------------------------------------------------------------------------
# Provider: "huggingface" (local) | "openai" | "custom_api".
SC_EMBEDDING_PROVIDER=huggingface

# For huggingface: any sentence-transformers model name.
# The default is multilingual so Persian / Arabic / etc. map into the same
# vector space as English without extra config.
SC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# For openai / custom_api: point at any OpenAI-compatible embeddings endpoint.
# SC_EMBEDDING_BASE_URL=https://api.openai.com
# SC_EMBEDDING_API_KEY=sk-...


# -----------------------------------------------------------------------------
# 5. Entity-aware caching (high-stakes domains: medical / legal)
# -----------------------------------------------------------------------------
# Master switch. When false, behavior is identical to the original
# similarity-only cache (the rest of this section is ignored).
SC_ENTITY_AWARE=false

# Domain: "general" | "medical" | "legal". `general` is rejected when
# ENTITY_AWARE=true — extraction needs a specialized prompt.
SC_DOMAIN=general

# LLM used for entity extraction. Any OpenAI-compatible chat model.
# NOTE: model slugs are gateway-specific. A bare slug that works on OpenAI
# (gpt-4o-mini) is a 404 on OpenRouter, which needs a provider prefix
# (openai/gpt-4o-mini). When unsure, list valid slugs first:
#   curl -s $SC_ENTITY_LLM_BASE_URL/v1/models -H "Authorization: Bearer $KEY"
SC_ENTITY_MODEL=gpt-4o-mini

# Stricter similarity floor applied ONLY in entity-aware mode. Should be
# stricter than SC_SIMILARITY_THRESHOLD.
SC_ENTITY_THRESHOLD=0.95

# Dedicated LLM endpoint. If unset, falls back to SC_EMBEDDING_BASE_URL.
# The extractor appends /v1/chat/completions automatically.
#
# --- OpenAI (default) ---
# SC_ENTITY_LLM_BASE_URL=https://api.openai.com
# SC_ENTITY_MODEL=gpt-4o-mini
#
# --- OpenRouter (verified working) ---
# SC_ENTITY_LLM_BASE_URL=https://openrouter.ai/api
# SC_ENTITY_MODEL=openai/gpt-4o-mini
#
# --- vLLM / local (often needs JSON mode off, see below) ---
# SC_ENTITY_LLM_BASE_URL=http://localhost:8000
# SC_ENTITY_MODEL=<served-model-id>
#
# SC_ENTITY_LLM_API_KEY=sk-...

# Per-call timeout (seconds). A timeout is treated as a cache MISS.
SC_ENTITY_LLM_TIMEOUT=10

# Send OpenAI's `response_format={"type": "json_object"}`. Turn OFF for
# OpenAI-compatible gateways that 400 on the field (vLLM, some Anthropic
# shims). The tolerant parser still extracts the JSON object.
SC_ENTITY_USE_JSON_MODE=true

# TTL (seconds) for the per-query entity-extraction cache when
# CachedEntityExtractor is wired in. Cuts LLM cost on repeat queries.
# 0 disables.
SC_ENTITY_EXTRACTION_CACHE_TTL=3600
